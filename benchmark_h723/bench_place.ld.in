/* Generated by CMake from bench_place.ld.in -- do not edit the generated copy.
 *
 * Two MEASURED placement variables of the H723 tier (2026-11-01), both decided
 * here at the link and never in a source file:
 *
 *   .itcm_text  -- code the firmware copies from flash into the 64 KB ITCM at
 *                  boot (rnnoise_place.c), before the caches are enabled and
 *                  before any of it runs. BENCH_RNNOISE_ITCM=ON selects the
 *                  RNNoise objects (transforms, pitch search, LPC, the GRU and
 *                  its kernel, denoise, the processor wrapper) plus libm and
 *                  libgcc; OFF leaves the section empty and everything in flash
 *                  behind the I-cache.
 *   .axi_rodata -- read-only data copied from flash into AXI SRAM (RAM_D1,
 *                  cached write-back by the default map) at boot.
 *                  BENCH_RNNOISE_WEIGHTS=AXI selects every RNNoise weight array
 *                  (rnn_data.c as shipped, rnn_nn8_weights.c for the int8 GRUs);
 *                  FLASH leaves them where the link puts them.
 *
 * Both sections precede .text / .rodata in the script, because ld assigns an
 * input section to the FIRST output section whose pattern matches it. The
 * patterns below are empty-matching when a variable is off, so the symbols
 * always exist and rnnoise_place.c copies zero bytes.
 */
  .itcm_text :
  {
    . = ALIGN(8);
    _sitcm = .;
    @BENCH_ITCM_PATTERNS@
    . = ALIGN(8);
    _eitcm = .;
  } >ITCMRAM AT> FLASH
  _siitcm = LOADADDR(.itcm_text);

  .axi_rodata :
  {
    . = ALIGN(32);
    _saxirodata = .;
    @BENCH_AXI_RODATA_PATTERNS@
    . = ALIGN(32);
    _eaxirodata = .;
  } >RAM_D1 AT> FLASH
  _siaxirodata = LOADADDR(.axi_rodata);
