/* Generated by CMake from bench_ram.ld.in -- do not edit the generated copy.
 *
 * Selects the RAM region that holds the benchmark's .data/.bss. This is a
 * MEASURED VARIABLE of the H723 tier, not a build convenience: DTCM is tightly
 * coupled and zero-wait-state but uncached and only 128 KB, while AXI SRAM is
 * 320 KB, sits behind the bus matrix and is cached (the Cortex-M7 default map
 * already marks 0x24000000 Normal write-back write-allocate, so no MPU
 * programming is needed to make that true).
 *
 * The stack and heap deliberately do NOT move: _estack is pinned to the top of
 * DTCMRAM, so a stack-placement difference never contaminates the comparison.
 */
REGION_ALIAS("BENCH_RAM", @BENCH_RAM_REGION@);
