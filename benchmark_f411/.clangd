CompileFlags:
  Add:
    - '-ferror-limit=0'
    - '-Wno-implicit-int'
    - '-Wno-unused-function'
    - '-D_LIBCPP_HAS_NO_THREADS'
  CompilationDatabase: .
Diagnostics:
  Suppress:
    - unused-includes
    - unused-function
    - unknown_typename
    - unknown_typename_suggest
    - typename_requires_specqual
